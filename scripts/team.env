# Single source of truth for machine IPs, team letter and paths.
# Fill in the four IPs (ipconfig getifaddr en0 on each Mac). No spaces around "=".
# If anyone's IP changes: update it HERE, commit, push, and everyone pulls.
# The scripts substitute these into the configs in configuration/phase2/ when installing them.

MAC1_IP=10.7.5.108        # Mac 1: primary DNS (dnsmasq) + test client
MAC2_IP=10.7.22.206    # Mac 2: edge nginx (TLS + load balancer)
MAC3_IP=10.7.17.193    # Mac 3: Backend A :3001 + standby edge (Ext E)
MAC4_IP=10.7.2.47      # Mac 4: Backend B :3002 + backup DNS (Ext A) + test client

TEAM=1                 # team number
DOMAIN="app.team${TEAM}.test"
WIFI_SERVICE="Wi-Fi"

# The team's mkcert root CA, used by curl (--cacert) instead of ever using -k.
# On Mac 2 it lives in "$(mkcert -CAROOT)"; copy ONLY rootCA.pem (never rootCA-key.pem) to the other Macs.
CA_FILE="$HOME/cn-project/tls/rootCA.pem"

# Homebrew paths (Apple Silicon)
DNSMASQ_BIN=/opt/homebrew/sbin/dnsmasq
DNSMASQ_CONF=/opt/homebrew/etc/dnsmasq.conf
NGINX_CONF=/opt/homebrew/etc/nginx/nginx.conf
CERT_DIR=/opt/homebrew/etc/nginx/certs
